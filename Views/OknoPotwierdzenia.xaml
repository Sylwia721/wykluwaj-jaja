<Window x:Class="WykluwajJaja.Views.OknoPotwierdzenia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Potwierdzenie"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Tlo}"
        Foreground="{StaticResource Tekst}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Tresc" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Tak" Width="90" Margin="0,0,10,0" Click="Tak" />
            <Button Content="Nie" Width="90" Click="Nie" />
        </StackPanel>
    </StackPanel>
</Window>
