<UserControl x:Class="WykluwajJaja.Views.WidokPoziomowTrudnosci"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Poziomy trudności"
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,10" />

        <ListBox Grid.Row="1" ItemsSource="{Binding PoziomyTrudnosci}"
                 SelectedItem="{Binding WybranyPoziom}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Nazwa}" FontSize="18" Width="120" />
                        <TextBlock Text="{Binding LiczbaKlikniec}" FontSize="18" />
                        <TextBlock Text=" kliknięć" FontSize="18" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Margin="0,10,0,0" FontSize="16">
            <Run Text="Wybrany poziom:" />
            <Run Text="{Binding WybranyPoziom.Nazwa, Mode=OneWay}" FontWeight="Bold" />
        </TextBlock>
    </Grid>
</UserControl>
