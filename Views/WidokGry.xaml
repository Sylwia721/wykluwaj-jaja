<UserControl x:Class="WykluwajJaja.Views.WidokGry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Wykluwaj jaja" FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10" />

        <Button Grid.Row="1" x:Name="PrzyciskJajka"
                Command="{Binding KliknijCommand}"
                PreviewMouseLeftButtonDown="Podskok"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="Transparent" BorderThickness="0" Padding="0">
            <Button.RenderTransform>
                <TranslateTransform />
            </Button.RenderTransform>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Image Source="{Binding Zdjecie}" Stretch="Uniform" MaxHeight="300" />
                        <Image Source="{Binding Zwierze}" Stretch="Uniform" MaxHeight="190"
                               IsHitTestVisible="False"
                               Visibility="{Binding Gratulacje, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,0">
            <TextBlock Text="{Binding Postep}" FontSize="16" HorizontalAlignment="Center"
                       Visibility="{Binding GraTrwa, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="Gratulacje! Wykluło się zwierzątko!" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource Roz}" HorizontalAlignment="Center" Margin="0,4,0,0"
                       Visibility="{Binding Gratulacje, Converter={StaticResource BoolToVis}}" />
            <Button Content="{Binding TekstStart}" Command="{Binding ZagrajCommand}"
                    MinWidth="200" Margin="0,10,0,0"
                    Visibility="{Binding WidocznyStart, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</UserControl>
